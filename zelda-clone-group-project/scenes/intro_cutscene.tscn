offset_right = 1154.0
offset_bottom = 60.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 17
text = "A guard at the castle watchtower has witnessed suspicious activity out in the woods, what seems to be inhuman soldiers of unknown origin."

[node name="Label2" type="Label" parent="."]
layout_mode = 0
offset_left = 24.0
offset_top = 94.0
offset_right = 1123.0
offset_bottom = 122.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 20
text = "These soldiers seem to be camping out nearby, setting up in the perfect place for an ambush along the main road."

[node name="Label3" type="Label" parent="."]
layout_mode = 0
offset_left = 296.0
offset_top = 149.0
offset_right = 819.0
offset_bottom = 191.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 30
text = "This spells trouble... serious trouble!"

[node name="Label4" type="Label" parent="."]
layout_mode = 0
offset_left = 33.0
offset_top = 230.0
offset_right = 1142.0
offset_bottom = 265.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 24
text = "If these soldiers are playing the role of bandits, then our castle may be cut-off from the capital!"

[node name="Label5" type="Label" parent="."]
layout_mode = 0
offset_left = 18.0
offset_top = 300.0
offset_right = 1146.0
offset_bottom = 326.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 18
text = "That means we may not receive the resources we need from traveling merchants, which may leave us vulnerable once winter hits!"

[node name="Label6" type="Label" parent="."]
layout_mode = 0
offset_left = 36.0
offset_top = 358.0
offset_right = 1122.0
offset_bottom = 392.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 24
text = "If we don't do something soon, the castle may fall into enemy hands the next time it is sieged!"

[node name="Label7" type="Label" parent="."]
layout_mode = 0
offset_left = 102.0
offset_top = 418.0
offset_right = 1050.0
offset_bottom = 460.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 30
text = "Scout out the main road and take care of those inhuman soldiers!"

[node name="Label8" type="Label" parent="."]
layout_mode = 0
