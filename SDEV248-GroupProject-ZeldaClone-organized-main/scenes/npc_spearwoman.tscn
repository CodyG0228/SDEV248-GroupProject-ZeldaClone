[node name="NPC Spearwoman" type="CharacterBody2D" unique_id=73876376 groups=["NPC"]]
script = ExtResource("1_bl8n6")
dialogue_text = "Greetings, O Great Wizard. Looks like they finally sent you in. I've found the inhuman soldiers. Took out a few of them myself already. They seem to be some sort of lizardmen, their bodies covered with thick scales that resist blades, which makes them tough to kill with ordinary weaponry. You shouldn't have a problem though, your spells should cut right through their physical resistances. Go ahead, I'll stay behind to make sure none of them sneak up on you."

