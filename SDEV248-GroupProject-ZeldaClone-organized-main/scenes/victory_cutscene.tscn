theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_font_sizes/font_size = 22
text = "Thank you O Great Wizard, you have secured the supply line for the castle. Now that our resources are save, we can focus on preparing ourselves for the coming threat. I highly doubt that the neighboring kingdom will back down just because we foiled their inital plan. 
Still... we should enjoy the peace while it lasts. 
Our scouts will continue to check for more of those inhuman soldiers, or anything worse.
If Mad Queen Kaelistra was willing to send these things to disrupt a supply line, there's no telling what she might send to attempt to take control of the castle in the future.
Enough about that though, it's time to celebrate."
autowrap_mode = 2

